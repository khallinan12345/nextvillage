# Copy this to .env.local and fill in real values (get them from Kevin) —
# .env.local is gitignored, so it never gets committed.
#
# Just testing a page in the browser (npm run dev:frontend)? You only need
# the two VITE_ variables below. Everything else is for the AI chat/backend
# features (npm run dev, or the api/*.ts serverless functions) and for
# scripts that talk to third-party services directly.

# ── Required to load the app at all ────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend / AI features (npm run dev, api/*.ts) ──────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=
CEREBRAS_API_KEY=
AI_TOGETHER_API_KEY=
HF_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
E2B_API_KEY=
RESEND_API_KEY=
CRON_SECRET=
NEWS_API_SECRET=
SPEECHGEN_TOKEN=
SPEECHGEN_EMAIL=
SPEECHGEN_VOICE=
