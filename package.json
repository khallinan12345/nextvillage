{
  "name": "nextvillage",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node real-e2b-server.cjs",
    "dev:frontend": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "deadcode": "knip",
    "security-check": "node scripts/security/security-check.mjs",
    "preview": "vite preview",
    "assess:baseline": "tsx --env-file=.env.local scripts/baseline.ts",
    "assess:monthly": "tsx --env-file=.env.local scripts/monthly.ts",
    "user:delete": "tsx --env-file=.env.local scripts/delete-user.ts",
    "org:block-learners": "tsx --env-file=.env.local scripts/block-org-learners.ts",
    "org:deidentify-learners": "tsx --env-file=.env.local scripts/deidentify-org-learners.ts",
    "accounts:purge-due": "tsx --env-file=.env.local scripts/purge-due-accounts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@e2b/code-interpreter": "^1.5.1",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "classnames": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "e2b": "^1.7.1",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "openai": "^7.43.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.34.1",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.9.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "core-js@3.44.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.27.3": true,
    "esbuild@0.21.5": true
